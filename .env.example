# Local PostgreSQL settings used by Docker Compose.
# Copy to .env and replace POSTGRES_PASSWORD before the first database start.
POSTGRES_DB=ubique_prayer
POSTGRES_USER=ubique
POSTGRES_PASSWORD=replace_with_a_long_local_password
POSTGRES_PORT=5432

# Host port for the backend container; use 8081 if local bootRun uses 8080.
BACKEND_PORT=8080

# Set false to disable both OpenAPI JSON and Swagger UI.
API_DOCS_ENABLED=true
